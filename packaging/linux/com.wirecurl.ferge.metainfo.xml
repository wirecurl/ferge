<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.wirecurl.ferge</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>ferge</name>
  <summary>Move files between your computer and servers</summary>
  <developer id="com.wirecurl">
    <name>wirecurl</name>
  </developer>

  <description>
    <p>
      ferge is a fast, keyboard-first file transfer client. This computer is on the left, a
      server on the right, and files go between them, or between two servers, with copy and
      paste, a key press or drag and drop.
    </p>
    <ul>
      <li>SFTP with your SSH configuration, keys, agent and known hosts</li>
      <li>Folders with 100,000 entries scroll, sort and filter without delay</li>
      <li>A transfer queue that pauses, resumes within a file and survives a restart</li>
      <li>Direct copies between two servers that never pass through this computer</li>
      <li>Working as root through sudo, without a root login</li>
      <li>Previews of text, pictures, spreadsheets, office documents and PDF pages</li>
      <li>Saved passwords in the desktop's keyring</li>
    </ul>
  </description>

  <screenshots>
    <screenshot type="default">
      <caption>This computer and a server side by side, with uploads in the transfer queue</caption>
      <image>https://raw.githubusercontent.com/wirecurl/ferge/main/docs/screenshots/hero-light.png</image>
    </screenshot>
    <screenshot>
      <caption>Two servers about to copy files directly, without going through this computer</caption>
      <image>https://raw.githubusercontent.com/wirecurl/ferge/main/docs/screenshots/direct.png</image>
    </screenshot>
    <screenshot>
      <caption>A folder the account cannot open, and the same server as root through sudo</caption>
      <image>https://raw.githubusercontent.com/wirecurl/ferge/main/docs/screenshots/root.png</image>
    </screenshot>
    <screenshot>
      <caption>Favorites, hosts from the SSH configuration and recent connections</caption>
      <image>https://raw.githubusercontent.com/wirecurl/ferge/main/docs/screenshots/servers.png</image>
    </screenshot>
    <screenshot>
      <caption>A spreadsheet in the preview</caption>
      <image>https://raw.githubusercontent.com/wirecurl/ferge/main/docs/screenshots/preview.png</image>
    </screenshot>
  </screenshots>

  <launchable type="desktop-id">com.wirecurl.ferge.desktop</launchable>
  <provides>
    <binary>ferge</binary>
  </provides>

  <url type="homepage">https://github.com/wirecurl/ferge</url>
  <url type="bugtracker">https://github.com/wirecurl/ferge/issues</url>
  <url type="vcs-browser">https://github.com/wirecurl/ferge</url>

  <categories>
    <category>Network</category>
    <category>FileTransfer</category>
  </categories>
  <keywords>
    <keyword>sftp</keyword>
    <keyword>ssh</keyword>
    <keyword>transfer</keyword>
    <keyword>remote</keyword>
  </keywords>

  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>

  <branding>
    <color type="primary" scheme_preference="light">#f3f4f1</color>
    <color type="primary" scheme_preference="dark">#0d1215</color>
  </branding>

  <content_rating type="oars-1.1"/>

  <releases>
    <release version="0.1.0" date="2026-11-22">
      <url type="details">https://github.com/wirecurl/ferge/releases/tag/v0.1.0</url>
      <description>
        <p>The first release.</p>
      </description>
    </release>
  </releases>
</component>
